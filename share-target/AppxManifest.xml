<?xml version="1.0" encoding="utf-8"?>
<!-- MyAgent share-target sparse package (F24).
     Adapted from WorkBuddy WorkBuddyShareTarget.msix structure: the package
     only registers identity + ShareTarget extension; the executable stays in
     the install directory (sparse). Identity name must match the certificate
     subject used by register.ps1 (CN=MyAgentShare). -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    IgnorableNamespaces="uap">
  <Identity Name="MyAgentShare"
            Publisher="CN=MyAgentShare"
            Version="1.0.0.0"
            ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>MyAgent Share</DisplayName>
    <PublisherDisplayName>phil</PublisherDisplayName>
    <Logo>assets\icon.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>
  <Applications>
    <Application Id="ShareTarget" Executable="share-target\MyAgentShareTarget.cmd" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="MyAgent Share" Square150x150Logo="assets\icon.png"
                          Square44x44Logo="assets\icon.png" Description="Share files with MyAgent"
                          BackgroundColor="transparent">
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Send to MyAgent">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
